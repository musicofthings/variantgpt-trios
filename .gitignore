# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/

# Node
node_modules/
.wrangler/
.dev.vars
.dev.vars.*
*.log
.vite/
dist/

# Fly.io
.fly/

# Editors
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Runtime artifacts (user uploads + per-case engine output)
data/uploads/
data/cases/
data/raw/
app/web/public/cases/
tracks/cache/

# Genomic data — never commit real patient data.
# Demo VCFs (data/test/demo_trio/*.vcf) are explicitly re-included below.
*.vcf
*.vcf.gz
*.vcf.gz.tbi
*.bam
*.bai
*.bam.bai
*.cram
*.crai
# Raw reads (FASTQ) — the rawest PHI; never commit.
*.fastq
*.fq
*.fastq.gz
*.fq.gz
!data/test/demo_trio/*.vcf

# Engine case output — never commit per-case results.
case.json
!data/test/**/case.json

# Reports
*.pdf
!docs/**/*.pdf

# IDE / agent-generated MCP descriptors — can steer agents toward local case
# directories (security.md §2.1, §7). Never commit.
mcps/

# Env
.env
.env.local
.env.*
!.env.example
