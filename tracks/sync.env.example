# Env for tracks/sync_ftp_to_r2.sh on the Hyderabad sync VM.
# Copy to sync.env, fill in real values, then: chmod 600 sync.env
# NEVER commit the filled-in version (sync.env is gitignored via .env.*).

# Partner SFTP (MedGenome). ROTATE the password before first use.
FTP_HOST=sftp.medgenome.com
FTP_PORT=2222
FTP_USER=Dr_Rajesh_Bendre.11496
FTP_PASS=__set_new_password__
FTP_PATH=/projects

# Cloudflare R2 (same values used on the Worker / Fly engine).
R2_ACCOUNT_ID=__r2_account_id__
R2_ACCESS_KEY_ID=__r2_access_key_id__
R2_SECRET_ACCESS_KEY=__r2_secret_access_key__
R2_BUCKET=variantgpt
DATA_PREFIX=data/incoming

# Optional: limit the first run to validate before pulling everything, e.g.
#   RCLONE_EXTRA=--max-transfer 5G
# or a single sample folder:
#   RCLONE_EXTRA=--include "B_O_Sumana_Maity*/**"
